{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis/revenue-event/v1",
  "title": "JARVIS Verified Revenue Event",
  "type": "object",
  "required": ["event_id", "project_id", "event_type", "source_event_id", "occurred_at", "amount", "currency", "confidence", "evidence", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["payment.completed", "sale.completed", "revenue.recorded", "payment.refunded", "sale.refunded", "revenue.reversed"]},
    "source_event_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "amount": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "confidence": {"const": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "payload": {
      "type": "object",
      "properties": {
        "fees": {"type": "number", "minimum": 0},
        "fulfillment_cost": {"type": "number", "minimum": 0},
        "advertising_cost": {"type": "number", "minimum": 0},
        "refunds": {"type": "number", "minimum": 0}
      }
    }
  }
}
