{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis/autonomy-policy/v1",
  "title": "JARVIS Autonomy Policy",
  "type": "object",
  "required": ["schema_version", "decision_order", "decisions", "global", "project_gates", "default_tier"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decisions": {"type": "array", "contains": {"const": "execute"}},
    "global": {"type": "object", "required": ["execute", "require_approval", "prohibited"]},
    "grants": {"type": "object"},
    "project_gates": {"type": "object"},
    "default_tier": {"type": "object", "required": ["GREEN", "YELLOW", "RED", "UNKNOWN"]}
  }
}
