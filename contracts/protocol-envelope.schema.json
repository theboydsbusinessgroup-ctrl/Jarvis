{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis/protocol-envelope/v1",
  "title": "JARVIS Protocol Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "protocol",
    "target_kind",
    "target_id",
    "task_id",
    "trace_id",
    "context_fingerprint",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"enum": ["mcp", "a2a"]},
    "target_kind": {"enum": ["tool", "data", "agent"]},
    "target_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "context_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"target_kind": {"enum": ["tool", "data"]}}},
      "then": {"properties": {"protocol": {"const": "mcp"}}}
    },
    {
      "if": {"properties": {"target_kind": {"const": "agent"}}},
      "then": {"properties": {"protocol": {"const": "a2a"}}}
    }
  ],
  "additionalProperties": false
}
