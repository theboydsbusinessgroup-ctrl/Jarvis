{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis/orchestration-policy/v1",
  "title": "JARVIS Orchestration Policy",
  "type": "object",
  "required": [
    "schema_version",
    "max_parallel_workers",
    "max_delegation_depth",
    "allowed_target_roles",
    "required_context_fields",
    "preserve_context_fields"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "max_parallel_workers": {"type": "integer", "minimum": 1, "maximum": 16},
    "max_delegation_depth": {"type": "integer", "minimum": 1, "maximum": 5},
    "allowed_target_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_context_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "preserve_context_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
